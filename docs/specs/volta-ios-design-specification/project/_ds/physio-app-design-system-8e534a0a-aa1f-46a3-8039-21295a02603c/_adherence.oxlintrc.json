{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/clinical/**",
              "components/core/**",
              "ui_kits/physio-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|clinical|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, clinical, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|primary|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'primary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='clinical'] > Literal[value!=/^(?:pos|neg|neutralStatus|red|yellow|anamnese|objektiv|gelenke|befund|planung)$/]",
        "message": "<Badge> clinical must be one of 'pos' | 'neg' | 'neutralStatus' | 'red' | 'yellow' | 'anamnese' | 'objektiv' | 'gelenke' | 'befund' | 'planung'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|interactive|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, interactive, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|id|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, label, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|active|onToggle|children|key|ref|className|style|children)$/]",
        "message": "<FlagChip> doesn't accept that prop. Declared props: type, active, onToggle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagChip'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:red|yellow)$/]",
        "message": "<FlagChip> type must be one of 'red' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|mono|emphasized|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, invalid, mono, emphasized."
      },
      {
        "selector": "JSXOpeningElement[name.name='NrsSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|emphasized|key|ref|className|style|children)$/]",
        "message": "<NrsSlider> doesn't accept that prop. Declared props: value, onChange, label, emphasized."
      },
      {
        "selector": "JSXOpeningElement[name.name='Phase'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|token|key|ref|className|style|children)$/]",
        "message": "<Phase> doesn't accept that prop. Declared props: key, label, token."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|accent|label|showValue|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, accent, label, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|id|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestStatusToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|size|key|ref|className|style|children)$/]",
        "message": "<TestStatusToggle> doesn't accept that prop. Declared props: value, onChange, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestStatusToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<TestStatusToggle> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|cutoff|pass|size|key|ref|className|style|children)$/]",
        "message": "<ValueReadout> doesn't accept that prop. Declared props: label, value, unit, cutoff, pass, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueReadout'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ValueReadout> size must be one of 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
